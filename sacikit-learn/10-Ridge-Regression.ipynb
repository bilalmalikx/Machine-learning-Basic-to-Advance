   "source": [
    "from sklearn.linear_model import Ridge\n",
    "import numpy as np\n",
    "\n",
    "X = np.array([[1, 2], [3, 4], [5, 6]])\n",
    "y = np.dot(X, np.array([1, 2])) + 3\n",
    "model = Ridge(alpha=1.0)\n",
    "model.fit(X, y)\n",
    "predictions = model.predict(X)\n",
    "print(predictions)"
   ]
  }
 ],
